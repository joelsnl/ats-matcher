# Path to a local GGUF (Qwen2.5-7B-Instruct Q4_K_M recommended)
LLAMA_MODEL_PATH=

# GPU layers for llama.cpp: -1 = all, 0 = CPU only
LLAMA_N_GPU_LAYERS=-1

# Context window
LLAMA_N_CTX=8192

# Optional GitHub PAT (Phase 3). Public-repo read is enough.
GITHUB_TOKEN=

# Job source: linkedin | playwright | adzuna
JOBS_PROVIDER=linkedin
