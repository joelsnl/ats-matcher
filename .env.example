# Path to a local GGUF (Qwen3-8B Q4_K_M recommended).
# Optional if a .gguf file is already in .models/
LLAMA_MODEL_PATH=

# GPU layers for llama.cpp: 0 = CPU (default), -1 = all GPU layers
LLAMA_N_GPU_LAYERS=0

# Context window
LLAMA_N_CTX=8192

# Comma-separated registered job channels (currently only linkedin)
JOBS_PROVIDER=linkedin

# Public job-search bounds and process-local cache
JOBS_TIMEOUT=15
JOBS_REQUEST_DELAY=2
JOBS_RETRIES=2
JOBS_MAX_PAGES=8
JOBS_CACHE_TTL=3600
# Fetch each listing page for the full description (slower; uses the same delay)
JOBS_FETCH_DESCRIPTIONS=true
# Translate non-English descriptions with Google Translate
JOBS_TRANSLATE=true
JOBS_TRANSLATE_TO=en
